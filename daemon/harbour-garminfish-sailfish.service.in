[Unit]
Description=GarminFish daemon
After=pre-user-session.target
After=lipstick.service
# The daemon is the only thing that keeps notifications flowing: never give up
# restarting it.
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/harbour-garminfishd
Restart=always
RestartSec=5
Environment=HOME=%h XDG_CONFIG_HOME=/home/%u/.config DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/dbus/user_bus_socket XDG_RUNTIME_DIR=/run/user/%U

[Install]
WantedBy=user-session.target
